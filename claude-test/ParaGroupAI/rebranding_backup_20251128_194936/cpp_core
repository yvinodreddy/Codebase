#!/usr/bin/env bash
#
# PRSG - Para Group AI Orchestrator® wrapper for ultrathink.py
#
# This is the Para Group AI Orchestrator® version of ULTRATHINK, completely isolated from TestPrompt.
# It calls ultrathink.py with all the same arguments.
#
# Usage:
#   prsg "your prompt"
#   prsg "your prompt" --api
#   prsg --file prompt.txt
#   prsg --help
#   prsg "prompt" -v     (verbose mode)
#

# CRITICAL: Preserve original working directory if not already set
# This allows nested calls to maintain the original context
if [ -z "$ULTRATHINK_ORIGINAL_CWD" ]; then
    export ULTRATHINK_ORIGINAL_CWD="$(pwd)"
fi

# Get the directory where this script is actually located (resolve symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Call ultrathink.py with all arguments
# The exec replaces this process with Python, but environment variables are preserved
exec python3 "$SCRIPT_DIR/ultrathink.py" "$@"
